# ============================================================================
#  AI DETAIL PAGE MAKER — 환경변수
#  아무 것도 안 채워도 "로컬 모드"로 바로 실행됩니다 (로그인 없음, 브라우저 저장, mock 이미지).
# ============================================================================

# ── AI 카피 / 상품 분석 / 이미지 프롬프트 기획 (Claude) ────────────────────
# 없으면 목업(mock) LLM 으로 전체 흐름이 그대로 동작합니다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium

# ── 이미지 생성기 ────────────────────────────────────────────────────────
# IMAGE_PROVIDER 를 비워두면, 아래 키가 있는 생성기를 자동으로 씁니다.
#   nanobanana(권장) | higgsfield | mock
IMAGE_PROVIDER=nanobanana

# ── Nano Banana = Google Gemini 2.5 Flash Image ─────────────────────────
# 필요한 것: Google AI Studio API 키 하나.
#   1) https://aistudio.google.com/apikey  접속
#   2) "Create API key" 클릭 → 키 복사
#   3) 아래 NANOBANANA_API_KEY 에 붙여넣기 → 저장 → 서버 재시작
# 누끼컷을 레퍼런스로 넣으면 제품 원형을 유지한 연출컷을 만들어 줍니다.
NANOBANANA_API_KEY=
NANOBANANA_MODEL=gemini-2.5-flash-image
# (선택) 엔드포인트 오버라이드 — 보통 비워둡니다
NANOBANANA_API_URL=

# ── Higgsfield (선택) ───────────────────────────────────────────────────
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=https://api.higgsfield.ai/v1

# 섹션당 후보 이미지 수
IMAGE_CANDIDATES_PER_SECTION=3

# ── Supabase (로그인 + DB + 이미지 저장) — 배포 시 ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 로그인 방식 (둘 중 하나) ────────────────────────────────────────────
#
# 방법 A) 비밀번호 1개 (가장 간단, Supabase 대시보드 설정 불필요) ★권장
#   APP_PASSWORD 를 채우면 "비밀번호 모드"로 전환됩니다.
#   접속 시 이 비밀번호만 입력하면 됩니다. (Google/이메일 인증 설정 안 해도 됨)
APP_PASSWORD=
# (선택) 쿠키 서명용 시크릿. 비워두면 APP_PASSWORD 로 대체.
APP_SESSION_SECRET=
#
# 방법 B) Supabase Auth (구글/매직링크 + 이메일 화이트리스트)
#   APP_PASSWORD 를 비워두고 ALLOWED_EMAIL 을 채우면 이 모드가 됩니다.
#   ※ 이 모드는 Supabase 대시보드 → Authentication → URL Configuration 에
#     배포 도메인을 Site URL / Redirect URLs 로 등록해야 로그인이 완료됩니다.
ALLOWED_EMAIL=
